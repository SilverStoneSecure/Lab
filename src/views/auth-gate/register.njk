<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Register — SilverStoneLab</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>◈ Create account</h1>
      {% if error %}
      <div class="auth-error">{{ error }}</div>
      {% endif %}
      {% if not error or token %}
      <form method="post" action="/portal/register">
        <input type="hidden" name="token" value="{{ token }}" />
        <div class="auth-field">
          <label for="username">Choose a username</label>
          <input id="username" type="text" name="username" required autocomplete="username" autofocus />
        </div>
        <div class="auth-field">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" required autocomplete="new-password" />
        </div>
        <button type="submit" class="auth-submit">Create account</button>
      </form>
      {% endif %}
      <p style="margin-top:1.25rem;font-size:.72rem;color:var(--dim)">
        <a href="/portal/login" style="color:var(--accent)">← Back to sign in</a>
      </p>
    </div>
  </div>
</body>
</html>
