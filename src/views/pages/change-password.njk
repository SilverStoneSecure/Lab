{% extends "layouts/base.njk" %}
{% block title %}Set your password{% endblock %}
{% block content %}
<div class="wrap">
  <header>
    <div class="brand">
      <h1>Set your password</h1>
      <p class="subtitle">Choose a new password to continue.</p>
    </div>
  </header>
  <section>
    <div class="note">
      {% if error %}
      <p class="auth-error">{{ error }}</p>
      {% endif %}
      <form method="post" action="/change-password">
        <p><label>New password <input type="password" name="password" required minlength="8" autofocus /></label></p>
        <p><label>Confirm password <input type="password" name="confirm" required minlength="8" /></label></p>
        <p><button type="submit" class="action-btn action-btn--save">Set password</button></p>
      </form>
    </div>
  </section>
</div>
{% endblock %}
