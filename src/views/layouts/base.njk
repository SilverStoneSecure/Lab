<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="{% if site and site.meta_description %}{{ site.meta_description }}{% else %}SilverStone homelab dashboard.{% endif %}"
    />
    <title>{% block title %}{% if site and site.page_title %}{{ site.page_title }}{% else %}SilverStoneLab{% endif %}{% endblock %}</title>
    <link rel="stylesheet" href="/public/ss-brand.css" />
    <link rel="stylesheet" href="/public/styles.css" />
    {% block head %}{% endblock %}
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
  </head>
  <body>
    {% block content %}{% endblock %}
  </body>
</html>
