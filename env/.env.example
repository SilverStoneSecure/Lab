NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DB_CLIENT=sqlite
SQLITE_PATH=./data/app.db
SESSION_SECRET=change-this-to-a-long-random-string
# Session cookie Secure flag: 1 behind HTTPS, 0 for plain HTTP (e.g. local Docker on port 3000)
SESSION_SECURE=0

# Docker entrypoint only (ignored by plain npm run start)
RUN_MIGRATE_ON_START=1
RUN_SEED_ON_START=0
